<?xml version="1.0" encoding="utf-8"?>
<!--
  A fixed footer holding the button, with only the fields scrolling above it.

  The obvious layout — everything in one ScrollView — puts Connect below the
  fold on a 480px-tall screen the moment the keyboard opens, so it looks like
  the form has no button at all and the keyboard's own Done key becomes the
  thing people press. Pinning it costs one nested layout and means the button
  is on screen whatever the keyboard is doing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/void_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pair_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pair_body"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Host and port share a line: on a 480px-tall screen every row
                 spent is a row the keyboard will cover. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/host"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:hint="@string/pair_host"
                    android:inputType="textUri"
                    android:imeOptions="actionNext"
                    android:autofillHints="no"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <EditText
                    android:id="@+id/port"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:hint="@string/pair_port"
                    android:inputType="number"
                    android:imeOptions="actionNext"
                    android:autofillHints="no"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </LinearLayout>

            <EditText
                android:id="@+id/token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/pair_token"
                android:inputType="textVisiblePassword"
                android:imeOptions="actionDone"
                android:autofillHints="no"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/microphone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pair_mic"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:textColor="#FF8A8A"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:text="@string/pair_save" />
</LinearLayout>
