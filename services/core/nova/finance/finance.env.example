# N.O.V.A. finance credentials.
#
#   cp finance.env.example finance.env
#   chmod 600 finance.env
#
# This file belongs in the data directory (NOVA_HOME, /var/lib/nova on a
# systemd install), NOT in the config directory. It is read only by
# nova/finance and by nothing else: it is never sent to a client, never
# included in a settings export, never written by the settings panel, and
# never part of any prompt.
#
# Anything set in the environment wins over anything set here, so a systemd
# unit or a container can supply these without them touching a file at all:
#
#   systemctl edit nova
#   [Service]
#   Environment=NOVA_FINANCE_TOKEN=...
#
# finance.env is in .gitignore. Check before you commit anyway.

# Starling personal access token, from developer.starlingbank.com.
# Read-only scopes are enough unless the payday split is enabled:
#   account:read  balance:read  transaction:read
# The split additionally needs savings-goal:read and savings-goal-transfer:create.
NOVA_FINANCE_TOKEN=

# Shared secret the bank signs webhook deliveries with. Only needed when
# finance.webhook_enabled is on. Without it the listener refuses to start,
# deliberately: an endpoint that accepts anything claiming to be a transaction
# would let anyone on the network make N.O.V.A. announce a purchase that never
# happened.
NOVA_FINANCE_WEBHOOK_SECRET=
